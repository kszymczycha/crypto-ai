# LIVE environment — copy to config/env/live.env and do NOT commit it.
# Keep secrets (api_key, secret_key, passphrase) only in secrets/okx_live.toml.
OKX_FLAG=0
BOT_MODE=live
CONFIG_DIR=config
DATA_DIR=data
LOGS_DIR=logs
LOG_LEVEL=INFO
COLLECTOR_INTERVAL_SECONDS=60
EXECUTOR_URL=http://executor:8080
