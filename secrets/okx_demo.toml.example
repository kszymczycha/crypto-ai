# Secrets template. Copy to secrets/okx_demo.toml (demo) or secrets/okx_live.toml (live).
# *.toml files in secrets/ are ignored by git; this template (*.example) is not.
# API key: spot trade ONLY, NO withdraw, IP whitelist.
api_key = "CHANGE_ME"
secret_key = "CHANGE_ME"
passphrase = "CHANGE_ME"
flag = "1"   # '1' = demo/sandbox, '0' = live