# Copy to .env (ignored by git). Only non-secret switches belong here.
COMPOSE_PROJECT_NAME=okxbot
OKX_FLAG=1
BOT_MODE=demo
LOG_LEVEL=INFO
EXECUTOR_URL=http://executor:8080
# Model provider for OpenCode (fill in .env; do not commit .env).
# OPENCODE_BASE_URL is an Anthropic-API-compatible endpoint, e.g. https://.../anthropic
OPENCODE_BASE_URL=
OPENCODE_API_KEY=
OPENCODE_MODEL_ID=deepseek-v4.1-flash
# OKX secrets do NOT go into .env — only into secrets/*.toml (read-only mount).
